      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "B" }
      ],
      "fieldConfig": { "defaults": {
        "unit": "s", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
      }, "overrides": [
        { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0072B2" } }] },
        { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#85B8DC" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row", "title": "처리량", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "panels": []
    },
    {
      "type": "timeseries", "title": "토큰 처리량 (tok/s)", "id": 20,
      "description": "입력에는 vision 토큰 포함. 입력이 출력보다 훨씬 큰 것이 이 워크로드의 정상 (prefill-dominated).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        { "expr": "sum(rate(vllm:generation_tokens_total[2m]))", "legendFormat": "출력", "refId": "A" },
