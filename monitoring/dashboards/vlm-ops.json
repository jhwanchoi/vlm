        { "matcher": { "id": "byName", "options": "입력" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C77F00" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
