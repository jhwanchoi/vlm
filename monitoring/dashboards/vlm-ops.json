{
  "uid": "vlm-ops",
  "title": "VLM 운영 한눈에",
  "description": "docs/10 판단 규칙 기반 운영 대시보드. 상단 타일이 전부 초록이면 정상. 임계값 근거: docs/09 실측 + docs/10 SLO 제안.",
  "tags": ["vlm", "ops"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row", "title": "지금 상태", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "type": "stat", "title": "서빙 레플리카", "id": 1,
      "description": "정상 = 4. 하나라도 빠지면 즉시 확인 (serve.sh status).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "count(up{job=\"vllm\"} == 1) OR on() vector(0)", "refId": "A", "instant": false }],
      "fieldConfig": { "defaults": {
        "unit": "none", "min": 0, "max": 4, "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 4 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value", "textMode": "value", "justifyMode": "center" }
    },
    {
      "type": "stat", "title": "처리 중 요청", "id": 2,
      "description": "슬롯 상한 64 (max-num-seqs 16 x 4). 상한 근처 지속 = 대기 큐 발생 직전.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(vllm:num_requests_running)", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "none", "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 48 }, { "color": "red", "value": 64 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "대기 큐", "id": 3,
      "description": "0이 정상. 지속적으로 0 초과 = 용량 부족, DP 증설 판단 신호 (docs/10 3번).",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(vllm:num_requests_waiting)", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "none", "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "큐 대기 p95 (5분)", "id": 4,
      "description": "요청이 스케줄러에 잡히기까지 기다린 시간. 레플리카 열화/용량 부족의 최선행 신호.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "s", "noValue": "요청 없음", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "TTFT p95 (5분)", "id": 5,
      "description": "인터랙티브 SLO 제안: p95 7초 이내 (docs/10 2번). 배치 전용 구간에서는 초과해도 무방.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "s", "noValue": "요청 없음", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 7 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "출력 처리량 (tok/s)", "id": 6,
      "description": "실측 상한 약 1,508 tok/s (DP=4, docs/09). 색 없음: 판정 지표가 아니라 참고 지표.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "targets": [{ "expr": "sum(rate(vllm:generation_tokens_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "none", "noValue": "0", "decimals": 0,
        "color": { "mode": "fixed", "fixedColor": "#0072B2" }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "KV 사용률 (최대 레플리카)", "id": 7,
      "description": "부하 실측 최대 64% (docs/09 6번). 90% 초과 + preemption 발생 = 메모리 병목.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 5 },
      "targets": [{ "expr": "max(vllm:kv_cache_usage_perc)", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "noValue": "0", "min": 0, "max": 1, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.9 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Preemption (1시간)", "id": 8,
      "description": "0이 정상 기대값 (docs/10 3번). 발생 = KV 압박, gpu-memory-utilization/max-num-seqs 재검토.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "targets": [{ "expr": "sum(increase(vllm:num_preemptions_total[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "none", "noValue": "0", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 20 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "row", "title": "지연 (SLO)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "panels": []
    },
    {
      "type": "timeseries", "title": "TTFT (첫 토큰까지)", "id": 10,
      "description": "빨간 점선 = 인터랙티브 SLO 제안 7초. 배치 부하 중 초과는 정상.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "B" }
      ],
      "fieldConfig": { "defaults": {
        "unit": "s", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true,
          "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "transparent", "value": null }, { "color": "red", "value": 7 } ] }
      }, "overrides": [
        { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0072B2" } }] },
        { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#85B8DC" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "E2E (요청 전체 완료)", "id": 11,
      "description": "tool calling agent 체감 지표 (docs/10 2번: agent는 TTFT가 아니라 E2E로 판정).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "B" }
      ],
      "fieldConfig": { "defaults": {
        "unit": "s", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
      }, "overrides": [
        { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0072B2" } }] },
        { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#85B8DC" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "TPOT (출력 토큰당 시간)", "id": 12,
      "description": "decode 속도. 동시성을 올리면 함께 오르는 것이 정상. 급등은 병목 신호.",
